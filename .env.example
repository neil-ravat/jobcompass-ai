# Safe public template. Copy to .env, chmod 600 .env, then edit locally.
# Values are data, never shell code. Do not source this file or use shell tracing.
# Exported variables take precedence. Use literal values, not ${VARIABLE} expansion.

# Actual local PostgreSQL endpoint; keep its password separate from the URL.
# Set DATABASE_URL to an empty value to deliberately use the JSON store instead.
DATABASE_URL=postgresql://jobcompass@127.0.0.1:55432/jobcompass
# Required for password-authenticated PostgreSQL. Supply your own password locally.
# Compose also uses this as its database initialization password (POSTGRES_PASSWORD).
# Changing .env does not change an existing native/container database password.
PGPASSWORD=
# Only this dedicated database is used by integration tests; never point at app data.
TEST_DATABASE_URL=postgresql://jobcompass@127.0.0.1:55432/jobcompass_test

# Local job snapshots/status cache and downloaded embedding artifacts; both ignored.
JOBCOMPASS_DATA_DIR=data
JOBCOMPASS_MODEL_CACHE=data/models
# Native FastAPI launcher settings. Keep the unauthenticated local API on loopback.
JOBCOMPASS_HOST=127.0.0.1
JOBCOMPASS_PORT=8765
# Streamlit's HTTP backend URL only; never put credentials into this URL.
# Streamlit itself remains on 127.0.0.1:8501 via .streamlit/config.toml.
JOBCOMPASS_API_URL=http://127.0.0.1:8765

# Optional provider credentials: leave blank unless you already have genuine keys.
# Himalayas public access and all core search paths work without these credentials.
HIMALAYAS_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional: export PYTHON_DOTENV_DISABLED=1 to use only injected environment values.
# Compose sets this internally; tests isolate application/provider configuration.
# PYTHON_DOTENV_DISABLED=1
