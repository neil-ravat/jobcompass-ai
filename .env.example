# Examples only; the application reads exported environment variables.
JOBCOMPASS_DATA_DIR=data
JOBCOMPASS_MODEL_CACHE=data/models
# Unset DATABASE_URL for JSON storage. This URL is for the isolated local demo.
DATABASE_URL=postgresql://jobcompass@127.0.0.1:55432/jobcompass
# Optional: no key is needed for ingestion, recommendations or local semantic search.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
